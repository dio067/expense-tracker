{
  "name": "expense-tracker",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev --workspace=packages/server\" \"npm:dev --workspace=packages/web\"",
    "build": "npm run build --workspace=packages/server && npm run build --workspace=packages/web",
    "test": "npm run test --workspace=packages/server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
